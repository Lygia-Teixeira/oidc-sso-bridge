# Copie para .env e preencha. O .env NUNCA deve ser versionado.
# Gere os segredos com:  npm run keys
# O servico se recusa a subir enquanto houver CHANGE_ME nos segredos.

NODE_ENV=development
PORT=3000
# Quantos proxies reversos confiaveis ficam na frente (0 = acesso direto).
TRUST_PROXY_HOPS=0

# URL publica deste provedor OIDC (issuer). HTTPS obrigatorio em producao.
OIDC_ISSUER=http://localhost:3000

# Chave privada de assinatura dos ID Tokens (gerada por "npm run keys").
# Em desenvolvimento pode ficar vazio: o oidc-provider usa chave efemera.
JWKS_PATH=./keys/jwks.json

# Chaves de assinatura de cookies (separadas por virgula; a primeira assina,
# as demais so verificam - permite rotacao).
COOKIE_KEYS=CHANGE_ME_cookie_key_1_at_least_32_chars,CHANGE_ME_cookie_key_2_at_least_32_chars

# Base de usuarios da aplicacao legada (aberta SOMENTE LEITURA).
LEGACY_DB_PATH=./data/legacy-demo.db
# Papeis autorizados a usar a ponte (vazio = todos os ativos).
ALLOWED_ROLES=admin,member

# --- Relying Party (ex.: Vaultwarden) ---
RP_CLIENT_ID=vaultwarden
RP_CLIENT_SECRET=CHANGE_ME_client_secret_at_least_32_chars
# Lista exata de redirect URIs aceitas (separadas por virgula).
# Vaultwarden: {DOMAIN}/identity/connect/oidc-signin
RP_REDIRECT_URIS=http://localhost:8080/identity/connect/oidc-signin
RP_POST_LOGOUT_REDIRECT_URIS=
# PKCE S256 obrigatorio (recomendado). No Vaultwarden: SSO_PKCE=true.
PKCE_REQUIRED=true

# 2o fator por e-mail: true = para todos; false = so para quem ativou na base legada.
REQUIRE_EMAIL_OTP=false

# --- Fluxo "um clique" a partir da aplicacao legada (opcional) ---
LAUNCH_ENABLED=false
# Segredo HMAC compartilhado APENAS com a aplicacao legada.
LAUNCH_TICKET_SECRET=CHANGE_ME_launch_ticket_secret_at_least_32_chars
LAUNCH_TICKET_AUDIENCE=oidc-sso-bridge
# Validade maxima aceita para o tiquete, em segundos (teto absoluto 120).
LAUNCH_TICKET_MAX_TTL=60
# Tela do RP que inicia o fluxo OIDC (Vaultwarden: {DOMAIN}/#/sso).
# Mantenha as aspas: sem elas o "#" vira comentario.
RP_LOGIN_URL="http://localhost:8080/#/sso"

# --- E-mail do codigo de verificacao ---
# smtp (padrao) ou console (so desenvolvimento: imprime o e-mail no terminal)
MAIL_TRANSPORT=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
MAIL_FROM=no-reply@example.com
